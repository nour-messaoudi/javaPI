<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" padding="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.PostController">
    <Label text="Créer un nouveau Post"/>
    <TextField fx:id="titreField" promptText="Titre"/>
    <TextArea fx:id="contenuField" promptText="Contenu"/>
    <TextField fx:id="auteurField" promptText="Auteur"/>
    <ComboBox fx:id="topicIdCombo" promptText="Sélectionner un Topic"/>
    <HBox spacing="10">
        <Button text="Créer" onAction="#handleCreatePost"/>
        <Button text="Annuler" onAction="#closeCurrentWindow"/>
    </HBox>
</VBox>
