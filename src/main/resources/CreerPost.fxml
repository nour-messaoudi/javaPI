<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.PostController">
    <VBox spacing="15" alignment="TOP_CENTER" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Nouveau Post" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="15">
            <Label text="Titre:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titreField" promptText="Titre du post" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <Label text="Contenu:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextArea fx:id="contenuField" promptText="Contenu du post" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <Label text="Auteur:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="auteurField" promptText="Votre nom" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Annuler" style="-fx-background-color: #f44336; -fx-text-fill: white;" onAction="#cancelCreation"/>
            <Button text="Publier" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#createPost"/>
        </HBox>
    </VBox>
</AnchorPane>