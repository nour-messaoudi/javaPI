<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.ModifierPostController">
    <center>
        <VBox spacing="10.0" padding="20.0">
            <Label text="Modifier le Post" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <HBox spacing="10">
                <Label text="Titre:" minWidth="100"/>
                <TextField fx:id="titreField" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Contenu:" minWidth="100" alignment="TOP_LEFT"/>
                <TextArea fx:id="contenuField" prefRowCount="5" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Auteur:" minWidth="100"/>
                <TextField fx:id="auteurField" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Mettre à jour" onAction="#handleUpdate"/>
                <Button text="Annuler" onAction="#handleCancel"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>