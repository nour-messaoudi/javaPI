<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ModifierPostController"
      stylesheets="@style.css"
      spacing="10"
      style="-fx-background-color: #FAF5F0;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #D4B8A7;">
        <Label text="Modifier Post"
               style="-fx-text-fill: #5D4037; -fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Formulaire pour la modification du post -->
    <GridPane hgap="10" vgap="10" style="-fx-padding: 20;">
        <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-text-fill: #6D4C41; -fx-font-weight: bold;"/>
        <TextField fx:id="titreField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   style="-fx-background-color: white; -fx-border-color: #D4B8A7;"/>

        <Label text="Contenu:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-text-fill: #6D4C41; -fx-font-weight: bold;"/>
        <TextArea fx:id="contenuField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                  prefRowCount="5" wrapText="true"
                  style="-fx-background-color: white; -fx-border-color: #D4B8A7;"/>
    </GridPane>

    <!-- Boutons d'action -->
    <HBox spacing="20" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Mettre à jour" onAction="#handleUpdate"
                style="-fx-background-color: #A1887F; -fx-text-fill: white; -fx-font-weight: bold;"
                defaultButton="true"/>
    </HBox>
</VBox>