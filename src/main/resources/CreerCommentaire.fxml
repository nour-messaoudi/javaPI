<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.CreerCommentaire"
      stylesheets="@style.css"
      spacing="10"
      styleClass="root">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER" styleClass="header-box">
        <Label text="Nouveau Commentaire" styleClass="header-title"/>
    </HBox>

    <!-- Formulaire de création de commentaire -->
    <GridPane hgap="10" vgap="10" styleClass="form-container">
        <Label text="Contenu:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="contentField" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="ID du Post:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="postIdField" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="button-container">
        <Button text="Annuler" onAction="#closeWindow" styleClass="cancel-button"/>
        <Button text="Ajouter" onAction="#handleAdd" defaultButton="true" styleClass="save-button"/>
    </HBox>
</VBox>