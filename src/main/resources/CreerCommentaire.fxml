<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.CreerCommentaire"
            prefWidth="400" prefHeight="300">
    <children>
        <VBox spacing="10" alignment="CENTER" layoutX="20" layoutY="20" prefWidth="360">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="Créer un Commentaire" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <TextField fx:id="auteurField" promptText="Auteur" />
            <TextArea fx:id="contenuField" promptText="Contenu du commentaire" prefRowCount="4"/>
            <ComboBox fx:id="postComboBox" promptText="Sélectionner un post" prefWidth="300"/>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Créer" onAction="#handleCreate" />
                <Button text="Annuler" onAction="#handleCancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
