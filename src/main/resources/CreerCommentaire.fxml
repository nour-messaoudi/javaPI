<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.CreerCommentaire"
      spacing="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nouveau Commentaire" style="-fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Contenu:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="contentField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="ID du Post:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="postIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#closeWindow"/>
        <Button text="Ajouter" onAction="#handleAdd" defaultButton="true"/>
    </HBox>
</VBox>