<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.MenuPrincipalController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #f0f0f0;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Button text="Gestion des Posts"
            onAction="#handleAfficherPosts"
            style="-fx-font-size: 14pt; -fx-min-width: 200px; -fx-min-height: 50px;"/>

    <Button text="Gestion des Commentaires"
            onAction="#handleAfficherCommentaires"
            style="-fx-font-size: 14pt; -fx-min-width: 200px; -fx-min-height: 50px;"/>
</VBox>