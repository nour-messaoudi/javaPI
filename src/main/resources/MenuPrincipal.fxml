<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>


<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.MenuPrincipalController"
      spacing="20"
      alignment="CENTER"
      stylesheets="@style.css">

    <HBox alignment="CENTER" styleClass="header">
        <Label text="Bienvenue dans le Forum" />
    </HBox>

    <Button text="Gestion des Posts" onAction="#handleAfficherPosts" styleClass="button" />
    <Button text="Gestion des Commentaires" onAction="#handleAfficherCommentaires" styleClass="button" />
</VBox>