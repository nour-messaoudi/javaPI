<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AfficherCommentaireController">

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colContent" text="Contenu"/>
                <TableColumn fx:id="colPostId" text="Post ID"/>
                <TableColumn fx:id="colDate" text="Date"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
            <Button text="Ajouter" fx:id="btnAjouter" onAction="#handleAjouter"/>
            <Button text="Modifier" onAction="#handleModifier"/>
            <Button text="Supprimer" onAction="#handleSupprimer" style="-fx-text-fill: red;"/>
        </HBox>
    </bottom>
</BorderPane>