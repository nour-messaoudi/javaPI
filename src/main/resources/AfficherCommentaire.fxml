<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AfficherCommentaireController"
            stylesheets="@style.css">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 15;">
            <Label text="Gestion des Commentaires"
                   styleClass="label-title"
                   style="-fx-text-fill: white; -fx-font-size: 24px;"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Barre de recherche -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField promptText="Rechercher un commentaire..."
                           style="-fx-pref-width: 300;"/>
                <Button text="Rechercher" />
                <Button text="Actualiser" />
            </HBox>

            <!-- Tableau des commentaires -->
            <TableView fx:id="tableView" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <!--<TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;"/>-->
                    <TableColumn fx:id="colContent" text="Contenu" style="-fx-pref-width: 300;"/>
                    <TableColumn fx:id="colPostId" text="Post ID" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDate" text="Date de création" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Pied de page avec boutons d'action -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
            <Button text="Ajouter" fx:id="btnAjouter" onAction="#handleAjouter"/>
            <Button text="Modifier" onAction="#handleModifier"/>
            <Button text="Supprimer" onAction="#handleSupprimer"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="Exporter"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

    <!-- Styles supplémentaires directement dans le FXML -->
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
</BorderPane>