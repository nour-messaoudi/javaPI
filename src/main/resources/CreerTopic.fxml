<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.CreerTopic">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <spacing>10</spacing>

    <Label text="Nouveau Topic" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <GridPane>
        <padding>
            <Insets top="5" right="5" bottom="5" left="5"/>
        </padding>
        <hgap>10</hgap>
        <vgap>10</vgap>

        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Créateur:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="createurField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets top="10" right="0" bottom="0" left="0"/>
        </padding>
        <spacing>10</spacing>
        <Button text="Annuler" onAction="#handleCancel"/>
        <Button text="Créer" onAction="#handleCreate"/>
    </HBox>
</VBox>