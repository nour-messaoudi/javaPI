<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ModifierCommentaireController"
      spacing="10"
      style="-fx-background-color: #f0f0f0;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER" style="-fx-padding: 10; -fx-background-color: #3498db;">
        <Label text="Modifier Commentaire" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Formulaire pour la modification du commentaire -->
    <GridPane hgap="10" vgap="10">
        <Label text="Contenu:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="contentField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="ID du Post:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="postIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
        <Button text="Annuler" onAction="#closeWindow" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button text="Mettre à jour" onAction="#handleUpdate" defaultButton="true" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>
</VBox>