<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ModifierCommentaireController"
            prefWidth="400" prefHeight="300">

    <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Modifier Commentaire" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextArea fx:id="contenuField" promptText="Contenu du commentaire" prefRowCount="4" />
        <TextField fx:id="auteurField" promptText="Auteur" />

        <HBox spacing="10" alignment="CENTER">
            <Button text="Mettre à jour" onAction="#handleUpdate" />
            <Button text="Supprimer" onAction="#handleDelete" />
            <Button text="Annuler" onAction="#handleCancel" />
        </HBox>
    </VBox>

</AnchorPane>
