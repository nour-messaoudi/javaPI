<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.SupprimerPostController"
      spacing="20.0" alignment="CENTER" padding="20.0">
    <Label fx:id="confirmationLabel" text="Confirmer la suppression"
           style="-fx-font-weight: bold; -fx-text-alignment: center;" />

    <HBox spacing="15.0" alignment="CENTER">
        <Button text="Annuler" onAction="#handleCancel" />
        <Button text="Confirmer" style="-fx-text-fill: red;" onAction="#handleConfirm" />
    </HBox>
</VBox>