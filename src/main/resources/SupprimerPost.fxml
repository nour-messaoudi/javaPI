<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.SupprimerPostController"
      stylesheets="@style.css"
      spacing="20.0"
      alignment="CENTER"
      style="-fx-background-color: #FAF5F0;"
      padding="20.0">

    <Label fx:id="confirmationLabel" text="Confirmer la suppression"
           style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #6D4C41; -fx-text-alignment: center;" />

    <HBox spacing="20.0" alignment="CENTER">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Confirmer" onAction="#handleConfirm"
                style="-fx-background-color: #BCAAA4; -fx-text-fill: #5D4037; -fx-font-weight: bold;"/>
    </HBox>
</VBox>