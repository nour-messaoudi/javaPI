<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AfficherPostController"
            stylesheets="@style.css">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 15;">
            <Label text="Gestion des Posts"
                   style="-fx-text-fill: white; -fx-font-size: 24px;"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Table des posts -->
            <TableView fx:id="tableViewPosts" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <!--<TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;"/>-->
                    <TableColumn fx:id="colTitle" text="Titre" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colContent" text="Contenu" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCreatedAt" text="Date création" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Pied de page avec boutons d'action -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
            <Button text="Ajouter" onAction="#handleCreatePost" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            <Button text="Modifier" onAction="#handleUpdatePost" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Button text="Supprimer" onAction="#handleDeletePost" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>