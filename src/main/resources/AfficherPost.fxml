<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.PostController">
    <children>
        <VBox spacing="10" alignment="CENTER" layoutX="14" layoutY="14" prefWidth="600" prefHeight="400">
            <ComboBox fx:id="topicIdCombo" promptText="Choisir un topic" />
            <Button text="Charger les posts" onAction="#handleLoadPosts" />
        </VBox>
    </children>
</AnchorPane>
