<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AfficherPostController">
    <center>
        <TableView fx:id="tableViewPosts">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colTitle" text="Titre" />
                <TableColumn fx:id="colContent" text="Contenu" />
                <TableColumn fx:id="colCreatedAt" text="Date création" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Button text="Ajouter" onAction="#handleCreatePost" />
            <Button text="Modifier" onAction="#handleUpdatePost" />
            <Button text="Supprimer" onAction="#handleDeletePost" style="-fx-text-fill: red;" />
        </HBox>
    </bottom>
</BorderPane>